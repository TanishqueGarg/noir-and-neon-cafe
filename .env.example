# Hosted PostgreSQL: pooled runtime URL and direct migration URL.
DATABASE_URL=""
DIRECT_URL=""

# Dedicated disposable test database only. Never point this at production.
TEST_DATABASE_URL=""
ALLOW_DATABASE_TESTS="false"

# Resend transactional email. EMAIL_FROM must use a verified sender/domain.
RESEND_API_KEY=""
EMAIL_FROM=""
ADMIN_NOTIFICATION_EMAIL=""
# Optional per-attempt Resend timeout in milliseconds (bounded to 1000–15000).
EMAIL_SEND_TIMEOUT_MS="8000"

# Admin and distributed security controls. Use independent random values.
ADMIN_SESSION_HOURS="8"
RATE_LIMIT_SALT=""
CRON_SECRET=""

# One-time bootstrap only. Remove after creating the owner account.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Development seed requires this explicit opt-in and never runs in production.
ALLOW_DEVELOPMENT_SEED="false"

# Canonical public HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=""

# Optional public fallbacks until Business Settings are configured in PostgreSQL.
NEXT_PUBLIC_CAFE_ADDRESS=""
NEXT_PUBLIC_CAFE_PHONE=""
NEXT_PUBLIC_MAP_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
